{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Instalar dependencias",
      "type": "shell",
      "command": "./.venv/Scripts/python.exe -m pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Criar ambiente virtual (.venv)",
      "type": "shell",
      "command": "python -m venv .venv; ./.venv/Scripts/python.exe -m pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Rodar testes",
      "type": "shell",
      "command": "./.venv/Scripts/python.exe -m pytest -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      // SOBE SOZINHA AO ABRIR A PASTA. Pedido do operador, 11/09/2026:
      // ligar o computador e o programa ja estar rodando.
      //
      // Por que uma tarefa e nao o F5: o VS Code NAO tem como apertar
      // F5 por linha de comando - nao existe 'code --debug'. O que ele
      // tem, e e suportado, e esta tarefa disparando ao abrir a pasta.
      // Roda o MESMO run_ctp.py, no MESMO terminal integrado; o que
      // falta e o depurador atras, que um vigia de pasta nao usa.
      //
      // Abrir duas vezes nao duplica nada: travar_instancia_unica()
      // segura a segunda, e ela sai avisando. Foi o que salvou o
      // 08/09/2026, quando alguem deu F5 sem fechar a janela anterior e
      // saiu chapa duplicada.
      "label": "Iniciar CTP",
      "type": "shell",
      "command": "./.venv/Scripts/python.exe run_ctp.py",
      "group": { "kind": "build", "isDefault": true },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // SOBE SOZINHA AO ABRIR A PASTA, irma da "Iniciar CTP".
      //
      // POR QUE UMA SEGUNDA TAREFA, e nao um passo dentro da outra: sao
      // dois processos de proposito. A fila da montagem cair nao para o
      // fechamento de chapa dos outros clientes, e o vigia cair nao
      // derruba a tela que a equipe da AMERICA esta usando. Cada uma no
      // seu terminal ("panel": "dedicated"), cada uma cuidando da sua
      // vida.
      //
      // ABRIR DUAS VEZES NAO DUPLICA NADA: quem segura aqui e a porta.
      // A 8787 ja ocupada faz o servidor sair avisando, com o recado de
      // que alguem ja o abriu - e nao com um rastro de erro de rede.
      "label": "Iniciar montagem AMERICA",
      "type": "shell",
      "command": "./.venv/Scripts/python.exe run_montagem.py",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
